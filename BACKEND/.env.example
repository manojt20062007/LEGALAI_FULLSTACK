# ==================================================
# LM-Verify V1 Backend Configuration
# ==================================================

# Application
PROJECT_NAME="LM-Verify Backend"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database (PostgreSQL)
# For local development without PostgreSQL, sqlite can be used: sqlite:///./lmverify.db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lmverify"

# Redis & Async Processing
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"
# Set to True for running background tasks synchronously (e.g. for testing / direct local dev)
CELERY_ALWAYS_EAGER=False

# Object Storage (MinIO / S3-compatible or local fallback)
# Options: "local", "minio"
STORAGE_PROVIDER="local"
STORAGE_ENDPOINT="localhost:9000"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET="lm-verify-images"
STORAGE_SECURE=False
LOCAL_STORAGE_DIR="./uploads"
LOCAL_REPORT_DIR="./reports"

# OCR Provider
# Options: "mock" (default for development/testing), "paddleocr" (when PaddleOCR is installed)
OCR_PROVIDER="mock"

# Security & Upload Constraints
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=[".jpg", ".jpeg", ".png", ".webp"]

# CORS Configuration (Allowed frontend origins)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
